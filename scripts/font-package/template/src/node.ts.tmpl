import { readFile } from "node:fs/promises";

import { createNotoSans{{CODE}}, FILES, MISSING, type NotoSans{{CODE}}Options } from "./provider";

export type { NotoSans{{CODE}}Options, NotoSans{{CODE}}Weight } from "./provider";

export function notoSans{{CODE}}(opts: NotoSans{{CODE}}Options = {}) {
  return createNotoSans{{CODE}}(async (weight) => {
    try {
      return new Uint8Array(await readFile(new URL(`../fonts/${FILES[weight]}`, import.meta.url)));
    } catch (err) {
      throw new Error(MISSING, { cause: err });
    }
  }, opts);
}
