// @junejs/pdf-font-noto-sans-{{code}}/unbundled — the provider without its font files (#383). The
// default entries embed them (bun.ts as files, workerd.ts as Data modules), so a
// `bun build --compile` binary carries ~{{MIB_TOTAL}} MiB whether or not it renders {{LANGUAGE}}. This entry
// never references them: the app passes `load`, called on the first render with each weight's
// ref, and its bytes are checked against the ref's size and sha256 before they are used.
//
//   import { notoSans{{CODE}} } from "@junejs/pdf-font-noto-sans-{{code}}/unbundled";
//   typstWasmRenderer({ load, fonts: [notoSans{{CODE}}({ load })] });
//
// Runtime-neutral: no host imports.

import type { FontEgress } from "@junejs/pdf-typst-wasm";
import { loadVerified, type AssetLoader } from "./assets";
import { createNotoSans{{CODE}}, NOTO_SANS_{{CODE}}, type NotoSans{{CODE}}Options } from "./provider";

export { loadVerified, type AssetLoader, type AssetRef } from "./assets";
export { NOTO_SANS_{{CODE}}, type NotoSans{{CODE}}Options, type NotoSans{{CODE}}Weight } from "./provider";

export type UnbundledNotoSans{{CODE}}Options = NotoSans{{CODE}}Options & {
  // Gets a weight's file for its ref. Checked against the ref before the font is registered.
  load: AssetLoader;
  // What `load` contacts, for renderer.egress. Default: the refs' URL hosts, sending nothing
  // (the files may be downloaded). [] when the app pre-seeds them and never fetches.
  egress?: FontEgress[];
};

const HOSTS: FontEgress[] = [...new Set(Object.values(NOTO_SANS_{{CODE}}).flatMap((r) => r.urls.map((u) => new URL(u).host)))].map((host) => ({ host, sends: "nothing" }));

export function notoSans{{CODE}}(opts: UnbundledNotoSans{{CODE}}Options) {
  const { load, egress, ...rest } = opts;
  return createNotoSans{{CODE}}((weight) => loadVerified(NOTO_SANS_{{CODE}}[weight], load), rest, egress ?? HOSTS);
}
