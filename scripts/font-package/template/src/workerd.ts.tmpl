// @junejs/pdf-font-noto-sans-{{code}} on Cloudflare Workers (the `workerd` export condition): the
// files are imported as Data modules, so wrangler uploads them with the Worker. The two weights
// add ~{{MIB_TOTAL}} MiB to the Worker, next to the engine's 29 MiB, under the 64 MiB limit. Wrangler
// needs a rule for the extension; `june build` emits it (#379), and an app running wrangler
// on its own config adds it:
//
//   "rules": [{ "type": "Data", "globs": ["**/*.otf"], "fallthrough": true }]

import bold from "../fonts/NotoSans{{CODE}}-Bold.otf";
import regular from "../fonts/NotoSans{{CODE}}-Regular.otf";
import { createNotoSans{{CODE}}, type NotoSans{{CODE}}Options } from "./provider";

export type { NotoSans{{CODE}}Options, NotoSans{{CODE}}Weight } from "./provider";

export function notoSans{{CODE}}(opts: NotoSans{{CODE}}Options = {}) {
  return createNotoSans{{CODE}}(async (weight) => new Uint8Array(weight === 700 ? bold : regular), opts);
}
