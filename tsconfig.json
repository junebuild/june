{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "examples/basic/**/*.ts",
    "examples/basic/**/*.tsx"
  ],
  // mcp-interop.test.ts: see packages/core/tsconfig.json — the official MCP SDK's
  // deps export raw TS under the "source" condition this repo resolves.
  "exclude": ["**/node_modules", "**/dist", "packages/core/test/mcp-interop.test.ts"]
}
