{
  "name": "june-slack-feedback-agent",
  "main": "worker.ts",
  "compatibility_date": "2025-04-01",
  // Same flag `june build` emits: the DO runs each turn in a request scope built on
  // node:async_hooks (loaded lazily). Without it there is no scope: ambient
  // db/kv/blob throw "used outside a request scope", and currentServices()
  // returns undefined.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "JuneSlackDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JuneSlackDO"] }]
}
