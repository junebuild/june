{
  "name": "june-agent-edge",
  "main": "worker.ts",
  "compatibility_date": "2025-04-01",
  // Same flag `june build` emits: the DO runs each turn in a request scope built on
  // node:async_hooks (loaded lazily), so without it ambient db/kv/blob and
  // currentServices() silently stop resolving inside tools.
  "compatibility_flags": ["nodejs_compat"],
  // One SQLite-backed Durable Object class = the AgentSession actor on the edge.
  // The DO's ctx.storage.sql is the synchronous store the durable loop commits to.
  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "JuneAgentDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JuneAgentDO"] }]
}
