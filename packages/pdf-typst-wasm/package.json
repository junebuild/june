{
  "name": "@junejs/pdf-typst-wasm",
  "version": "0.1.0-dev.2",
  "description": "June — a PdfRenderer on a Typst to PDF engine compiled to WebAssembly: no browser, no native binary, and it runs on Cloudflare Workers.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://june.build",
  "exports": {
    ".": {
      "source": {
        "workerd": "./src/workerd.ts",
        "bun": "./src/bun.ts",
        "default": "./src/node.ts"
      },
      "bun": {
        "workerd": "./src/workerd.ts",
        "default": "./src/bun.ts"
      },
      "workerd": {
        "types": "./dist/workerd.d.ts",
        "default": "./dist/workerd.js"
      },
      "default": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    },
    "./typst.wasm": "./dist/typst.wasm"
  },
  "files": [
    "dist",
    "src/*.ts"
  ],
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.ts",
    "build": "bun run build:wasm && tsdown",
    "test": "bun test"
  },
  "dependencies": {
    "@junejs/pdf": ">=0.1.0-dev.2"
  },
  "devDependencies": {
    "@junejs/core": ">=0.2.0-dev.66",
    "@junejs/server": ">=1.0.0-dev.47"
  },
  "keywords": [
    "june",
    "agent",
    "pdf",
    "typst",
    "wasm",
    "cloudflare-workers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junebuild/june.git",
    "directory": "packages/pdf-typst-wasm"
  }
}
