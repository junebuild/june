// scripts/smoke-workerd.ts serves this with `wrangler dev --local`. The rule is the one an app
// adds for this package: wrangler has no default loader for .otf.
{
  "name": "pdf-font-noto-sans-tc-smoke",
  "main": "worker.ts",
  "compatibility_date": "2025-01-01",
  "rules": [{ "type": "Data", "globs": ["**/*.otf"] }]
}
