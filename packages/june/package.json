      "default": "./dist/agent-native.js"
    },
    "./agent-durable": {
      "source": "./src/agent-durable.ts",
      "bun": "./src/agent-durable.ts",
      "types": "./dist/agent-durable.d.ts",
      "default": "./dist/agent-durable.js"
    },
    "./agent-discover": {
      "source": "./src/agent-discover.ts",
