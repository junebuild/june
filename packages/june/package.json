{
  "name": "@junejs/server",
  "version": "0.1.2-dev.3",
  "description": "June host adapters + dev server. Host-coupled; depends on the pure @junejs/core contract layer.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://june.build",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "source": "./src/host.ts",
