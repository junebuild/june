  },
  "devDependencies": {
    "@libsql/client": "^0.17.3",
    "@types/pg": "^8.20.0",
    "mysql2": "^3.22.5",
    "pg": "^8.21.0",
    "react-server-dom-webpack": "catalog:"
  }
}
