  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "dependencies": {
    "@junejs/core": ">=0.1.1-dev.5",
    "@junejs/db": ">=0.0.34-dev.0",
    "@momiji-rs/sparkdown": "^0.0.4",
    "lightningcss": "^1.27.0",
    "oxc-parser": "^0.137.0",
    "rolldown": "^1.1.0"
