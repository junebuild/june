{
  "name": "@junejs/cli",
  "version": "0.0.51",
  "description": "The `june` CLI — dev / build / deploy / gen / info. A thin bin over @junejs/server.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://june.build",
  "bin": {
    "june": "./bin.mjs"
  },
  "exports": {
    ".": {
      "source": "./src/cli.ts",
      "bun": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "src",
    "bin.mjs",
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "dependencies": {
    "@junejs/core": ">=0.1.0",
    "@junejs/server": ">=0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/junebuild/june"
  }
}
