    "build": "tsdown"
  },
  "dependencies": {
    "@junejs/core": ">=0.2.0-dev.65",
    "marked": "^18.0.14"
  },
  "peerDependencies": {
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0"
