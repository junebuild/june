      "optional": true
    },
    "@myriaddreamin/typst-ts-web-compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@junejs/server": ">=1.0.0-dev.46",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0"
  },
  "keywords": [
    "june",
    "agent",
    "pdf",
    "typst",
    "wasm"
  ],
  "publishConfig": {
