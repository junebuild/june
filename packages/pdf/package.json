{
  "name": "@junejs/pdf",
  "version": "0.0.0",
  "description": "June — PDF output as an agent capability: a render_pdf tool over a replaceable PdfRenderer (Typst on WebAssembly by default).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://june.build",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./typst": {
      "source": "./src/typst.ts",
      "bun": "./src/typst.ts",
      "types": "./dist/typst.d.ts",
      "default": "./dist/typst.js"
    }
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "scripts": {
